{
  "name": "mobile-mirror",
  "version": "1.0.0",
  "description": "OpenCode GUI plugin: live Android screen mirror in the side panel with tap/swipe/key control over adb",
  "type": "module",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "android",
    "adb",
    "scrcpy",
    "mobile"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.2.6",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15"
  }
}
